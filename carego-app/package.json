{
  "name": "carego-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:dev": "ng build --configuration development",
    "test:engine": "esbuild tests/engine.flow.test.ts --bundle --platform=node --format=esm --outfile=.test-build/engine.mjs --log-level=warning && node .test-build/engine.mjs",
    "e2e:smoke": "node e2e/smoke.mjs",
    "e2e:flow": "node e2e/flow.mjs"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.17.0",
    "typescript": "~6.0.2"
  }
}
